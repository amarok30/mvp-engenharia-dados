    ]
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tags": {
    "projeto": "mvp-pipeline-dados"
  },
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "job_run_id",
      "default": "{{job.run_id}}"
    }
  ],
  "trigger": {
    "pause_status": "PAUSED",
    "file_arrival": {
      "url": "/Volumes/mafia_office/bronze/pouso/stackoverflow/"
    }
  },
  "health": {
    "rules": [
      {
        "metric": "RUN_DURATION_SECONDS",
        "op": "GREATER_THAN",
        "value": 2700
      }
    ]
  }
