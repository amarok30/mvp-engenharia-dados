{
  "name": "mvp-pipeline-dados",
  "description": "Pipeline do MVP em Bronze, Silver e Gold. Um notebook por tarefa, lido direto do repositório no GitHub (branch main). As duas fontes seguem em paralelo até a Silver e se juntam na verificação de qualidade. Compute serverless.",
  "git_source": {
    "git_url": "https://github.com/amarok30/mvp-engenharia-dados",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "00_setup_catalogo",
      "notebook_task": {
        "notebook_path": "notebooks/00_setup_catalogo",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true
    },
    {
      "task_key": "01_bronze_stackoverflow",
      "notebook_task": {
        "notebook_path": "notebooks/01_bronze_stackoverflow",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "00_setup_catalogo"
        }
      ],
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800
    },
